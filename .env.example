# Server-only keys. Add these in the Vercel project Environment Variables UI.
# Never commit real values.

# Required for Holdey answers on Grok, pictures, and clips
XAI_API_KEY=

# Optional — Holdey model picker (Answers / Hold copy)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Gemini aliases
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Impression server (Hold counts) ---
# HMAC secret for signed beacons (third-party Holders / Eng tooling)
INTERLUDE_IMPRESSION_SECRET=

# Optional Neon Postgres. When unset, PGLite embeds locally and auto-migrates.
DATABASE_URL=

# Admin bearer token for POST/GET /api/holders
INTERLUDE_ADMIN_TOKEN=

# Seed Holdey (+ demo) holder API keys. Required in production to seed.
# Outside production, deterministic DEV keys are used when unset.
INTERLUDE_SEED_HOLDER_KEY=
INTERLUDE_SEED_DEMO_HOLDER_KEY=

# Allow unsigned Holdey beacons from hold.js / Holdey chat (no x-interlude-key).
# Default: true when NODE_ENV !== production. Set 0 to require auth always.
INTERLUDE_ALLOW_UNSIGNED_HOLDEY=

# Optional JSON array of Hold campaigns for /api/decision (Starter weight 1, Growth weight 7).
# INTERLUDE_CAMPAIGNS_JSON=[{"id":"growth-northline","adId":"northline","tier":"growth","active":true}]
